{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["namespace", "planDigest", "resources"],
  "properties": {
    "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"},
    "planDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["apiVersion", "kind", "metadata"],
        "properties": {
          "apiVersion": {"enum": ["v1", "apps/v1", "networking.k8s.io/v1", "policy/v1"]},
          "kind": {"enum": ["Deployment", "Service", "Ingress", "PersistentVolumeClaim", "PodDisruptionBudget"]},
          "metadata": {"type": "object"},
          "spec": {"type": "object"}
        }
      }
    }
  }
}
