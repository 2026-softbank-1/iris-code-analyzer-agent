{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "needs_files"
        },
        "requestedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "requestedPaths",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "analysis"
        },
        "result": {
          "$ref": "#/$defs/analysis"
        }
      },
      "required": [
        "kind",
        "result"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "value": {},
        "status": {
          "enum": [
            "detected",
            "suggested",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "container",
            "development",
            "host_mapping",
            "source",
            "production"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "status",
        "scope",
        "evidenceIds",
        "reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "detected",
                  "suggested"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "evidenceIds": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "serviceId": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/field"
        },
        "role": {
          "$ref": "#/$defs/field"
        },
        "runtime": {
          "$ref": "#/$defs/field"
        },
        "buildCommand": {
          "$ref": "#/$defs/field"
        },
        "startCommand": {
          "$ref": "#/$defs/field"
        },
        "outputDirectory": {
          "$ref": "#/$defs/field"
        },
        "workingDirectory": {
          "$ref": "#/$defs/field"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "healthchecks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "componentRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "serviceId",
        "root",
        "role",
        "runtime",
        "buildCommand",
        "startCommand",
        "outputDirectory",
        "ports",
        "healthchecks",
        "componentRoots"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "code_review",
            "user_configuration"
          ]
        }
      },
      "required": [
        "key",
        "reason",
        "kind"
      ],
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "status": {
          "enum": [
            "complete",
            "needs_input",
            "unsupported"
          ]
        },
        "sourceSnapshotId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contextHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "apiRoutes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "environmentKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "completeForProfile": {
              "type": "boolean"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "completeForProfile",
            "limitations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "status",
        "sourceSnapshotId",
        "contextHash",
        "services",
        "dependencies",
        "apiRoutes",
        "environmentKeys",
        "connections",
        "questions",
        "coverage"
      ],
      "additionalProperties": false
    }
  }
}
