{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iris.example/contracts/planning-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "iris.planning-request.v1"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stack": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cloud": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture": {
          "anyOf": [
            {
              "enum": [
                "x86_64",
                "arm64"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "enum": [
            "test",
            "production"
          ]
        }
      },
      "required": [
        "stack",
        "environment"
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monthlyBudgetUsd": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedRps": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "anyOf": [
            {
              "enum": [
                "single_az",
                "multi_az"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceSnapshotId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "build",
              "test",
              "load",
              "runtime"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "measuredAt": {
            "type": "string",
            "format": "date-time"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "peakMemoryMiB": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cpuMillicores": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "achievedRps": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "p95LatencyMs": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "errorRate": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "peakMemoryMiB",
              "cpuMillicores",
              "achievedRps",
              "p95LatencyMs",
              "errorRate"
            ]
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "durationSeconds": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "concurrency": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "architecture": {
                "anyOf": [
                  {
                    "enum": [
                      "x86_64",
                      "arm64"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "imageDigest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capacityValidated": {
                "type": "boolean",
                "description": "Trusted evaluator attests sustained capacity against acceptance criteria; a fixed offered-load sample is false."
              }
            },
            "required": [
              "durationSeconds",
              "concurrency",
              "command"
            ]
          }
        },
        "required": [
          "id",
          "serviceId",
          "sourceSnapshotId",
          "kind",
          "verified",
          "measuredAt",
          "metrics",
          "conditions"
        ]
      },
      "minItems": 0
    },
    "pricingCatalog": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": {
              "enum": [
                "USD"
              ]
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "verifiedAt": {
              "type": "string",
              "format": "date-time"
            },
            "verified": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cloud": {
                    "type": "string",
                    "minLength": 1
                  },
                  "region": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "enum": [
                      "hour",
                      "gb_month",
                      "month"
                    ]
                  },
                  "unitPriceUsd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "instanceType": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "architecture": {
                    "anyOf": [
                      {
                        "enum": [
                          "x86_64",
                          "arm64"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cpuMillicores": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "memoryMiB": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceUrl": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  }
                },
                "required": [
                  "key",
                  "cloud",
                  "region",
                  "unit",
                  "unitPriceUsd",
                  "instanceType",
                  "architecture",
                  "cpuMillicores",
                  "memoryMiB"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "currency",
            "sourceUrl",
            "verifiedAt",
            "verified",
            "items"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "vpcMode": {
                  "enum": [
                    "create",
                    "existing"
                  ]
                },
                "vpcId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^vpc-[a-f0-9]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subnetIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^subnet-[a-f0-9]+$"
                  },
                  "minItems": 0
                },
                "availabilityZones": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "natGatewayCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "publicIngress": {
                  "type": "boolean"
                }
              },
              "required": [
                "vpcMode",
                "vpcId",
                "subnetIds",
                "availabilityZones",
                "natGatewayCount",
                "publicIngress"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeVerified": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "clusterName": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "existingClusterContext": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "serviceId",
              "reference"
            ]
          },
          "minItems": 0
        },
        "imagePlatforms": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "environmentKey": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._-]+$"
              }
            },
            "required": [
              "serviceId",
              "environmentKey",
              "name",
              "key"
            ]
          },
          "minItems": 0
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "host": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "className": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tlsSecretName": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "required": [
              "serviceId",
              "enabled",
              "host",
              "className",
              "tlsSecretName",
              "path"
            ]
          },
          "minItems": 0
        },
        "databases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "serviceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "engine": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "enum": [
                  "existing",
                  "managed"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "storageGiB": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "connectionSecretName": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "serviceIds",
              "engine",
              "version",
              "mode",
              "name",
              "storageGiB",
              "connectionSecretName"
            ]
          },
          "minItems": 0
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
              },
              "mountPath": {
                "type": "string",
                "pattern": "^/"
              },
              "claimName": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sizeGiB": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "storageClass": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessMode": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany"
                ]
              }
            },
            "required": [
              "serviceId",
              "name",
              "mountPath",
              "claimName",
              "sizeGiB",
              "storageClass",
              "accessMode"
            ]
          },
          "minItems": 0
        },
        "terraformInputs": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kubernetesVersion": {
                  "type": "string",
                  "pattern": "^1\\.[0-9]{2}$"
                },
                "administratorRoleArn": {
                  "type": "string",
                  "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
                },
                "nodeDiskGiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "desiredNodes": {
                  "type": "integer",
                  "minimum": 1
                },
                "privateNetworkEgressVerified": {
                  "type": "boolean"
                },
                "executorPrivateApiReachable": {
                  "type": "boolean"
                }
              },
              "required": [
                "kubernetesVersion",
                "administratorRoleArn",
                "nodeDiskGiB",
                "desiredNodes",
                "privateNetworkEgressVerified",
                "executorPrivateApiReachable"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ingressVerified": {
          "type": "boolean"
        },
        "storageDriverVerified": {
          "type": "boolean"
        },
        "databasesVerified": {
          "type": "boolean"
        },
        "availableCapacity": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpuMillicores": {
                  "type": "integer",
                  "minimum": 1
                },
                "memoryMiB": {
                  "type": "integer",
                  "minimum": 1
                },
                "nodeCount": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "cpuMillicores",
                "memoryMiB",
                "nodeCount"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": []
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instanceType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "requests": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cpuMillicores": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "cpuMillicores",
                  "memoryMiB"
                ]
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cpuMillicores": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "memoryMiB": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "cpuMillicores",
                  "memoryMiB"
                ]
              }
            },
            "required": [
              "serviceId",
              "requests",
              "limits"
            ]
          },
          "minItems": 0
        },
        "replicas": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "serviceId": {
                "type": "string",
                "minLength": 1
              },
              "replicas": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "serviceId",
              "replicas"
            ]
          },
          "minItems": 0
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "target"
  ]
}
