HIVE_AI=xxx
OPENAI_API=
OPENAI_MODEL=gpt-6-luna
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=zai-org/glm-5.3-flash
OPENCODE_PROVIDER=hive-ai
# Unset: Hive uses json_text; OpenAI uses structured.
# OPENCODE_OUTPUT_MODE=structured
OPENCODE_MAX_OUTPUT_TOKENS=8192
# Hive GLM and OpenAI GPT-6 Luna default to low reasoning effort.
# OPENCODE_REASONING_EFFORT=low
OPENCODE_MAX_REMOTE_RETRIES=0
# Set OPENCODE_URL only for a separately managed, isolated OpenCode 1.18.33 server.
